# Template for TaskPilot local development.
# `pnpm bootstrap` creates `.env.local` with generated secrets and checkout-specific values.
# Copying this file manually is optional. Never put real secrets in this example.

# =============================================================================
# Local checkout
# =============================================================================
# Checkout-scoped Docker Compose identity generated by `pnpm bootstrap`.
# Keep it stable so this checkout continues to use the same containers and volume.

# Docker Compose project name; isolates this checkout's containers and data volumes.
TASKPILOT_COMPOSE_PROJECT=taskpilot-my-checkout-1234abcd


# =============================================================================
# PostgreSQL
# =============================================================================
# Local PostgreSQL connection settings generated by `pnpm bootstrap`.
# Edit the host port only to resolve a local conflict; do not reuse the password elsewhere.

# Host port for PostgreSQL. The container still listens on 5432.
TASKPILOT_POSTGRES_PORT=15432

# Password for the local `taskpilot` PostgreSQL role.
TASKPILOT_POSTGRES_PASSWORD=replace-with-a-local-random-password


# =============================================================================
# Redis
# =============================================================================
# Local Redis connection settings generated by `pnpm bootstrap`.
# Redis stores ephemeral OAuth, rate-limit, and session state; PostgreSQL remains the durable source of truth.

# Host port for Redis. The container still listens on 6379.
TASKPILOT_REDIS_PORT=26379

# Password for the checkout-local Redis instance.
TASKPILOT_REDIS_PASSWORD=replace-with-a-local-random-password


# =============================================================================
# Core API
# =============================================================================
# Loopback endpoint used by the Desktop and local development checks.

# Host port for the loopback-only Core API.
TASKPILOT_CORE_API_PORT=45432


# =============================================================================
# Desktop
# =============================================================================
# Local development endpoint for the Desktop Renderer.

# Host port for the Desktop Renderer Vite development server.
TASKPILOT_DESKTOP_DEV_SERVER_PORT=55432


# =============================================================================
# Legal documents
# =============================================================================
# Canonical comma-separated locales accepted for the current legal document versions.
# Keep this aligned with the static Desktop legal catalog; unsupported or duplicate values fail closed.

# Approved legal-document locales for local registration.
TASKPILOT_AUTH_LEGAL_LOCALES=zh-CN,en


# =============================================================================
# Session security
# =============================================================================
# A 32-byte Base64 secret generated by `pnpm bootstrap`.
# Changing it invalidates existing local access and refresh tokens.

# HMAC key used to digest access and refresh session secrets.
TASKPILOT_AUTH_TOKEN_PEPPER_BASE64=replace-with-32-random-bytes-in-base64


# =============================================================================
# GitHub OAuth App
# =============================================================================
# Create a dedicated development OAuth App, then fill both credentials manually.
# Leaving either credential empty keeps Core API healthy and disables GitHub login.

# OAuth App Client ID. This identifier is not a secret.
TASKPILOT_GITHUB_CLIENT_ID=

# OAuth App Client Secret. Keep it only in this Git-ignored file.
TASKPILOT_GITHUB_CLIENT_SECRET=

# Authorization callback URL. Copy this exact value into the GitHub OAuth App;
# it must track TASKPILOT_CORE_API_PORT.
TASKPILOT_GITHUB_CALLBACK_URI=http://127.0.0.1:45432/desktop/v1/auth/federated/github/callback


# =============================================================================
# Federated login security
# =============================================================================
# Independent 32-byte Base64 secrets generated by `pnpm bootstrap`.
# Never reuse either value as the other key.

# HMAC key for OAuth state, polling, completion, and registration-continuation secrets.
TASKPILOT_FEDERATED_HMAC_KEY_BASE64=replace-with-32-random-bytes-in-base64

# AEAD key for PKCE verifiers, identity candidates, and short-lived authentication results.
TASKPILOT_FEDERATED_AEAD_KEY_BASE64=replace-with-a-different-32-random-bytes-in-base64
