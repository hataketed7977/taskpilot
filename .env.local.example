# `pnpm bootstrap` creates `.env.local` with random local-only values and
# checkout-specific ports. Copying this file manually is optional.
TASKPILOT_POSTGRES_PASSWORD=replace-with-a-local-random-password
TASKPILOT_AUTH_TOKEN_PEPPER_BASE64=replace-with-32-random-bytes-in-base64
TASKPILOT_AUTH_RECOVERY_KEY_BASE64=replace-with-32-random-bytes-in-base64
TASKPILOT_VERIFICATION_PEPPER_BASE64=replace-with-32-random-bytes-in-base64
TASKPILOT_COMPOSE_PROJECT=taskpilot-my-checkout-1234abcd
TASKPILOT_POSTGRES_PORT=15432
TASKPILOT_SMTP_PORT=25432
TASKPILOT_MAILPIT_HTTP_PORT=35432
TASKPILOT_CORE_API_PORT=45432
TASKPILOT_DESKTOP_DEV_SERVER_PORT=55432

# Optional: default mail mode is Mailpit. To send to a real test inbox, uncomment
# this block and keep credentials only in the Git-ignored .env.local. External
# SMTP must use required STARTTLS or implicit SSL; never enable both.
# TASKPILOT_VERIFICATION_MAIL_MODE=external
# TASKPILOT_EXTERNAL_SMTP_HOST=smtp.example.com
# TASKPILOT_EXTERNAL_SMTP_PORT=587
# TASKPILOT_EXTERNAL_SMTP_USERNAME=replace-with-provider-username
# TASKPILOT_EXTERNAL_SMTP_PASSWORD=replace-with-provider-password
# TASKPILOT_EXTERNAL_SMTP_FROM=no-reply@example.com
# TASKPILOT_EXTERNAL_SMTP_STARTTLS=true
# TASKPILOT_EXTERNAL_SMTP_SSL=false
