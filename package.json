{
  "name": "taskpilot",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "bootstrap": "node tools/dev/bootstrap.mjs",
    "dev": "node tools/dev/dev.mjs",
    "dev:api": "node tools/dev/dev.mjs api",
    "dev:desktop": "node tools/dev/dev.mjs desktop",
    "dev:stop": "node tools/dev/dev.mjs stop",
    "dev:restart": "node tools/dev/dev.mjs restart",
    "dev:status": "node tools/dev/dev.mjs status",
    "dev:logs": "node tools/dev/dev.mjs logs",
    "dev:doctor": "node tools/dev/dev.mjs doctor",
    "dev:help": "node tools/dev/dev.mjs help",
    "dev:smoke": "node tools/dev/dev.mjs smoke",
    "check": "node tools/dev/check.mjs",
    "hooks:install": "node tools/git-hooks/install.mjs",
    "hooks:test": "node --test tools/git-hooks/*.test.mjs",
    "hooks:pre-commit": "node tools/git-hooks/pre-commit.mjs",
    "hooks:commit-msg": "node tools/git-hooks/commit-msg.mjs",
    "dev:test": "node --test tools/dev/*.test.mjs",
    "desktop:quality": "pnpm --filter @taskpilot/desktop qualityCheck"
  }
}
